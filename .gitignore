node_modules/
dist/
# Generated at install by scripts/build-client.mjs; a copy here would shadow index.client.tsx.
/index.client.ts
*.tsbuildinfo
.showcase/showcase.js
.showcase/tools/collect.cjs
.worktrees/
.showcase/replay.js
.showcase/out/
.agents/

# Benchmark notes and scripts are tracked. Raw samples and generated video are
# release assets (this repo is a public fork, so Git LFS uploads are rejected)
# and are not part of a plugin clone.
docs/bench/**
!docs/bench/**/
!docs/bench/**/*.md
!docs/bench/**/*.mjs
!docs/bench/**/*.sh
!docs/bench/**/*.py
!docs/bench/**/*.js
!docs/bench/**/*.ts
!docs/bench/samples.txt
assets/promo/*.mp4
docs/video/generated/

/.playwright-mcp

# Archive: old delivery reports, plans and unused screenshots. Kept on disk, out of the clone.
.archive/

# Prototypes: the .md specs stay tracked (code cites them); boards, refs and HTML stay local.
docs/prototypes/*
!docs/prototypes/*.md

# QA and perf run output: screenshots, logs and patches stay on disk.
/output/
